+def roulade_dive_approach(
+    env: ManagerBasedRlEnv,
+    vx_lo: float = 0.1,
+    vx_hi: float = 0.5,
+    omega_ref: float = 3.0,
+    vz_ref: float = 0.3,
+    frontier_max: float = math.radians(90.0),
